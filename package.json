{
  "name": "launchcity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "review": "LAUNCHCITY_REVIEW_MODE=fixture next dev --port 3007",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test 'lib/**/*.test.ts'",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.131.2"
  }
}
