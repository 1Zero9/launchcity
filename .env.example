# Launch Library 2 (LL2) - all optional; the free tier works anonymously.
# LL2_BASE_URL=https://ll.thespacedevs.com/2.2.0
# LL2_API_TOKEN=

# Shared secret required on the /api/refresh endpoint. Leave unset only for
# local development; set it before deploying (see .github/workflows/refresh.yml).
# REFRESH_SECRET=

# Production KV cache (Upstash Redis REST API / Vercel KV compatible).
# When unset, the app falls back to a local filesystem cache under .cache/
# (see lib/cache/index.ts) - fine for local dev, not for a deployed
# serverless environment.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
