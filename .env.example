# Launch Library 2 (LL2) - all optional; the free tier works anonymously.
# LL2_BASE_URL=https://ll.thespacedevs.com/2.2.0
# LL2_API_TOKEN=

# Shared secret required on the /api/refresh endpoint (manual/diagnostic
# trigger only - the production scheduled refresh runs via Cloudflare Cron
# Triggers -> custom-worker.ts, which isn't reachable over HTTP and needs
# no secret of its own). Leave unset only for local development.
# REFRESH_SECRET=

# Production cache is a real Cloudflare KV namespace, bound in
# wrangler.jsonc (binding name: LAUNCHES_KV) - not configured via env vars.
# Set secrets for a deployed Worker with `wrangler secret put <NAME>`,
# never by committing them here. For local `next dev`, copy this file to
# .env.local (already gitignored); the KV binding itself is emulated
# automatically by initOpenNextCloudflareForDev() in next.config.ts.
